# Backend API — port 8001 (8000 is taken by another local project)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Must match the backend's NEXTAUTH_SECRET
NEXTAUTH_SECRET=
# Dev server runs on 3001 (3000 is taken by another local project)
NEXTAUTH_URL=http://localhost:3001

# OAuth (wired up in Phase 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
