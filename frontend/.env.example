# Backend API — port 8002 (8000 and 8001 are taken by other local projects)
NEXT_PUBLIC_API_URL=http://localhost:8002

# Must match the backend's NEXTAUTH_SECRET
NEXTAUTH_SECRET=
# Dev server runs on 3002 (3000 and 3001 are taken by other local projects)
NEXTAUTH_URL=http://localhost:3002

# OAuth (wired up in Phase 2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
