# Database — host port 5433 (see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://crxes:crxes@localhost:5433/crxes

# Redis — host port 6380 (Celery broker + SSE pub/sub)
REDIS_URL=redis://localhost:6380/0

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Auth — must match the frontend's NEXTAUTH_SECRET
NEXTAUTH_SECRET=

# Email
RESEND_API_KEY=re_...

# App
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
